# ─────────────────────────────────────────────────────────────────────────
# Keldya site — Vercel project env vars
# ─────────────────────────────────────────────────────────────────────────
# Set these in the Vercel dashboard:
#   Project → Settings → Environment Variables → Production
# All values are server-only (no NEXT_PUBLIC_ prefix needed).
# ─────────────────────────────────────────────────────────────────────────

# Resend API key — get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender. Until the keldya.com domain is verified with
# Resend, this MUST be a Gmail address whose inbox you control
# (Resend's free tier only sends from verified addresses).
# Format: "Display Name <email@domain>"
CONTACT_FROM_EMAIL=Keldya <keldyallc@gmail.com>

# Where the lead lands. Same address by default until we have a
# keldya.com inbox set up.
CONTACT_TO_EMAIL=keldyallc@gmail.com
